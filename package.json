{
  "name": "oddatlas",
  "version": "1.0.0",
  "description": "OddAtlas — a catalogue of strange, surprising places on Earth you can browse on a map and keep adding to.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://pavanit1217.github.io/oddatlas/",
  "repository": {
    "type": "git",
    "url": "https://github.com/PavanIT1217/oddatlas.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-places.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "node scripts/screenshots.mjs",
    "icons": "node scripts/generate-icons.mjs && npx @capacitor/assets generate --iconBackgroundColor '#050b14' --iconBackgroundColorDark '#050b14' --splashBackgroundColor '#050b14' --splashBackgroundColorDark '#050b14'",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run cap:sync && cap open android",
    "ios": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "playwright-core": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
