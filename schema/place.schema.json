{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pavanit1217.github.io/oddatlas/schema/place.schema.json",
  "title": "OddAtlas catalogue",
  "description": "An array of strange places. See README.md › Adding a place.",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/place" },
  "$defs": {
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "lat", "lng", "country", "category", "description", "whyStrange", "googleMapsUrl", "zoom", "tags", "dateAdded"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64, "description": "Unique kebab-case slug" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "country": { "type": "string", "minLength": 2, "maxLength": 60 },
        "category": {
          "enum": ["geoglyph", "landform", "water", "abandoned", "structure", "installation", "crater", "artificial-island", "fortification", "art", "other"]
        },
        "description": { "type": "string", "minLength": 20, "maxLength": 600 },
        "whyStrange": { "type": "string", "minLength": 20, "maxLength": 600 },
        "googleMapsUrl": {
          "type": "string",
          "pattern": "^https://www\\.google\\.com/maps/@-?\\d{1,2}(?:\\.\\d+)?,-?\\d{1,3}(?:\\.\\d+)?,\\d{1,2}z$"
        },
        "zoom": { "type": "integer", "minimum": 2, "maximum": 21 },
        "tags": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 32 }
        },
        "dateAdded": { "type": "string", "format": "date" }
      }
    }
  }
}
